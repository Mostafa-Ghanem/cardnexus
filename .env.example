# Cloudflare Workers (feature/cloudflare-workers-d1)
# Next.js app URL must match the deployed workers.dev hostname or custom domain.
# Configure secrets with "wrangler secret put KEY" or in the Workers dashboard.
APP_URL=https://cardnexus-workers-dev.YOUR_SUBDOMAIN.workers.dev
BETTER_AUTH_URL=https://cardnexus-workers-dev.YOUR_SUBDOMAIN.workers.dev
NEXT_PUBLIC_APP_URL=https://cardnexus-workers-dev.YOUR_SUBDOMAIN.workers.dev
BETTER_AUTH_SECRET=REPLACE_WITH_32_BYTE_RANDOM_SECRET

# Prisma CLI schema generation only; runtime always uses env.DB (Cloudflare D1).
DATABASE_URL=file:./dev.db

# Brevo transactional HTTPS API (verified sender required)
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=CardNexus

# Billing integrations (optional; secrets only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# D1 and R2 use native bindings DB and IMAGES in wrangler.jsonc.
# Never put R2 S3 credentials or MySQL passwords on this branch.
