# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ─── Branding & Arabic customization (all optional) ───────────────────────────
# Default platform name. The admin can change name/logo/colour later in
# /admin/settings (that value wins once saved in the database).
NEXT_PUBLIC_APP_NAME="كارت نكسس"
# Currency used to DISPLAY plan prices (ISO 4217). Must match Stripe/PayPal prices.
NEXT_PUBLIC_PRICE_CURRENCY=USD
# Contact address used on the upgrade page ("request upgrade" button).
NEXT_PUBLIC_SUPPORT_EMAIL=
# Slug of a public card shown as "live example" on the landing page.
NEXT_PUBLIC_DEMO_CARD_SLUG=
# Show "Save to Wallet" on public cards only when Apple/Google Wallet is configured.
NEXT_PUBLIC_WALLET_ENABLED=false

# Country calling code used to turn local numbers (05…) into WhatsApp links,
# e.g. 966 (Saudi Arabia), 20 (Egypt), 971 (UAE). Leave empty to require +format.
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=

# ─── Anti-spam for the public lead form (optional, recommended) ────────────────
# Cloudflare Turnstile (free): https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Number of reverse proxies in front of Node that append to X-Forwarded-For.
# 1 is correct for Hostinger. Used to read the real visitor IP for rate limits.
TRUSTED_PROXY_HOPS=1

# ─── Telegram instant lead alerts (optional) ──────────────────────────────────
# Create a bot with @BotFather. Secret: 20+ chars of A-Z a-z 0-9 _ - only.
# After deploying, open /admin/settings and press «تفعيل البوت» once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ─── Hostinger MySQL (create a dedicated database and user first) ────────────
# Use 127.0.0.1 instead of localhost with Node.js 22 on Hostinger.
# URL-encode reserved characters in the password.
DATABASE_URL="mysql://u123456789_user:REPLACE_WITH_PASSWORD@127.0.0.1:3306/u123456789_cardnexus"

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3000

# ─── Stripe (optional – required for paid plans) ───────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_YEARLY=price_...

# ─── PayPal (optional – alternative payment provider) ─────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_PRO_MONTHLY=
PAYPAL_PLAN_PRO_YEARLY=
PAYPAL_PLAN_BUSINESS_MONTHLY=
PAYPAL_PLAN_BUSINESS_YEARLY=
PAYPAL_WEBHOOK_ID=
# sandbox | live
PAYPAL_MODE=sandbox

# ─── SMTP / E-Mail ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465, false for other ports
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="كارت نكسس <noreply@example.com>"

# ─── Cloudflare R2 private bucket: required for persistent image uploads ────────
# Storage keys must be configured in Hostinger Web App Environment Variables.
# Create an R2 S3 token scoped to this bucket with Object Read & Write.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# One-time FIRST deployment only: set to true only after confirming a newly
# created EMPTY dedicated database. Never leave enabled for redeployments.
HOSTINGER_INITIAL_SETUP=false
# `npm run build` first runs scripts/db-additive-migrate.cjs, which only ADDS
# missing columns (never drops/changes data). Set true only to skip it.
SKIP_DB_MIGRATIONS=false

# ─── Apple Wallet (optional, not yet enabled) ──────────────────────────────────
# APPLE_CERT_PATH=
# APPLE_KEY_PATH=
# APPLE_TEAM_ID=
# APPLE_PASS_TYPE_ID=

# ─── Google Wallet (optional, not yet enabled) ─────────────────────────────────
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_KEY=
# GOOGLE_ISSUER_ID=
