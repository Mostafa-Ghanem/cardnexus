generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── better-auth required tables ─────────────────────────────────────────────

model user {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  // Role system
  role          String    @default("member") // super_admin | company_admin | team_leader | member

  // Two-factor authentication (TOTP)
  twoFactorEnabled Boolean @default(false)

  // Subscription plan
  plan                 String    @default("free") // free | pro | business
  planExpiresAt        DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  paypalSubscriptionId String?   @unique

  // Account status
  bannedAt      DateTime? // set = banned, null = active

  // Lead notification preference
  leadNotification String @default("off") // off | instant | daily

  // Referral
  referralCode  String?  @unique
  referredById  String?
  referredBy    user?    @relation("Referrals", fields: [referredById], references: [id])
  referrals     user[]   @relation("Referrals")

  // Relations
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  cards          Card[]
  sentInvitations Invitation[] @relation("InvitationSender")
  analytics      CardAnalytic[]
  notifications  Notification[]
  webhooks       Webhook[]
  apiKeys        ApiKey[]

  sessions       session[]
  accounts       account[]
  twoFactor      twoFactor[]

  @@map("user")
}

model twoFactor {
  id          String @id
  userId      String
  user        user   @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret      String
  backupCodes String
  verified    Boolean @default(true)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model session {
  id        String   @id
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime
  updatedAt DateTime

  @@map("session")
}

model account {
  id                   String    @id
  userId               String
  user                 user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId            String
  providerId           String
  accessToken          String?
  refreshToken         String?
  idToken              String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope                String?
  password             String?
  createdAt            DateTime
  updatedAt            DateTime

  @@unique([providerId, accountId])
  @@map("account")
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@map("verification")
}

// ─── App Models ──────────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  domain      String?
  primaryColor String  @default("#0F172A")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  isActive    Boolean  @default(true) // false = frozen (admin's Business plan cancelled)
  frozenAt    DateTime? // timestamp when org was frozen

  plan        String   @default("free") // free | pro | business
  customDomain String?

  users       user[]
  invitations Invitation[]
  settings    OrganizationSettings?
}

model OrganizationSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Branding defaults
  cardFooterText      String?
  defaultTemplate     String  @default("classic")
  defaultFontFamily   String  @default("inter")
  defaultLayoutStyle  String  @default("standard")
  defaultAccentColor  String?

  // Member permissions (global)
  allowMemberTemplateChange Boolean @default(true)
  allowMemberColorChange    Boolean @default(false)
  allowMemberFontChange     Boolean @default(true)
  allowMemberLayoutChange   Boolean @default(true)

  // Brand kit: JSON string[] of hex colors the org endorses
  brandColors String? // e.g. '["#0F172A","#2563EB","#16A34A"]'

  // Per-department overrides: JSON Record<deptName, DeptPolicy>
  // DeptPolicy: { allowTemplateChange?, allowColorChange?, allowFontChange?, allowLayoutChange? }
  departmentPolicies String?

  // Features
  walletEnabled          Boolean @default(false)
  analyticsEnabled       Boolean @default(true)
  leadCaptureEnabled     Boolean @default(false)
  teamDirectoryEnabled   Boolean @default(true)
  templateCardData       String? // JSON: default card values for new members

  // Integrations
  webhookUrl             String? // legacy single webhook URL (kept for simplicity)
  managerApproval        Boolean  @default(false)
}

model Card {
  id     String @id @default(cuid())
  userId String
  user   user   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identity
  slug      String  @unique
  isPublic  Boolean @default(true)

  // Personal
  firstName  String?
  lastName   String?
  title      String?
  company    String?
  department String?
  bio        String?
  avatarUrl  String?
  pronouns   String?  // e.g. "er/ihm", "she/her", "they/them"
  gender     String?  // vCard 4.0 GENDER: M | F | O | N | U or free text
  birthday   String?  // ISO date YYYY-MM-DD

  // Contact
  phone   String?
  mobile  String?
  fax     String?
  email   String?
  website String?
  address String?

  // Social
  linkedin  String?
  xing      String?
  twitter   String?
  instagram String?
  github    String?
  youtube   String?

  // Custom links (JSON array: [{label, url}])
  customLinks String @default("[]")

  // Appearance
  templateId     String  @default("classic")
  primaryColor   String  @default("#0F172A")
  accentColor    String?
  fontFamily     String  @default("inter")    // inter | serif | mono | display
  layoutStyle    String  @default("standard") // standard | centered | compact
  roundedStyle   String  @default("default")  // default | sharp | pill
  showQrOnCard   Boolean @default(false)
  coverUrl       String?

  // Extended appearance
  shadowStyle    String  @default("md")      // none | sm | md | lg | xl
  socialStyle    String  @default("icons")   // icons | outline | minimal
  avatarBorder   String  @default("none")    // none | ring | glow
  cardBackground String  @default("white")   // white | tinted | gradient
  logoUrl        String? // org logo (admin-controlled) or personal logo

  // Directory
  showInTeamDirectory Boolean @default(true)

  // Booking
  bookingUrl  String? // appointment booking URL (Cal.com, Calendly, etc.)

  // Visibility
  hideShareButton Boolean @default(false)

  // Custom domain
  cardDomain  String?

  // Card management
  name          String   @default("Meine Karte")
  isDefault     Boolean  @default(true)
  expiresAt     DateTime?
  passwordHash  String?

  // Approval workflow (used when OrganizationSettings.managerApproval = true)
  approvalStatus String  @default("approved") // approved | pending | rejected
  approvalNote   String?

  // Stats (denormalized for fast reads)
  totalViews Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analytics    CardAnalytic[]
  leads        Lead[]
  campaigns    Campaign[]
  slugAliases  CardSlugAlias[]

  @@index([userId])
}

model Campaign {
  id        String    @id @default(cuid())
  cardId    String
  card      Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  name      String
  urlSlug   String    @unique
  views     Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([cardId])
}

model Lead {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  message   String?
  createdAt DateTime @default(now())

  @@index([cardId])
}

model CardAnalytic {
  id        String   @id @default(cuid())
  cardSlug  String
  userId    String?
  user      user?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  card      Card?    @relation(fields: [cardSlug], references: [slug])

  event     String   // view | vcard_download | qr_scan | link_click | wallet_save
  linkLabel String?  // for link_click events
  source    String?  // nfc | qr | direct | share

  ip        String?
  country   String?
  city      String?
  device    String?  // mobile | desktop | tablet
  browser   String?  // Chrome | Firefox | Safari | Edge | ...
  os        String?  // Windows | macOS | iOS | Android | Linux | ...
  referrer  String? // document.referrer domain
  language  String?  // Accept-Language primary tag

  // UTM/campaign attribution. Captured on `view` events whenever the visitor
  // hits the page with utm_* params. Independent of the Campaign model so
  // ad-hoc share links also show up in analytics.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  createdAt DateTime @default(now())

  @@index([cardSlug])
  @@index([createdAt])
  @@index([utmCampaign])
  @@index([country])
}

model CardSlugAlias {
  id          String   @id @default(cuid())
  oldSlug     String   @unique
  cardSlug    String
  card        Card     @relation(fields: [cardSlug], references: [slug], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([oldSlug])
}

// ─── Platform-wide settings (singleton row, id = "main") ─────────────────────

model PlatformSettings {
  id             String  @id @default("main")
  appName        String  @default("FreddieCard")
  appUrl         String  @default("http://localhost:3000")
  faviconUrl     String?
  logoUrl        String?
  primaryColor   String  @default("#0F172A")
  supportEmail   String?
  footerText     String?
  allowedDomains String? // JSON array of allowed domain strings
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // milestone | system
  value     String   // e.g. "1000" for milestone count
  message   String
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@unique([userId, type, value], name: "userId_type_value")
  @@index([userId])
}

model Webhook {
  id        String   @id @default(cuid())
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  url       String
  events    String   @default("[\"lead\"]") // JSON: ["lead"]
  secret    String?  // HMAC-SHA256 signing secret
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
}

model ProcessedWebhookEvent {
  // Idempotency store for inbound provider webhooks (Stripe, PayPal, ...).
  // Composite key prevents accidentally processing a retry twice.
  id        String   @id @default(cuid())
  provider  String   // "stripe" | "paypal"
  eventId   String
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique // SHA-256 hash of the key
  prefix     String    // first 8 chars shown to user e.g. "fk_abc123"
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email          String
  role           String       @default("member")
  token          String       @unique
  expiresAt      DateTime

  senderId       String
  sender         user         @relation("InvitationSender", fields: [senderId], references: [id])

  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([token])
  @@index([email])
}

model RateLimitBucket {
  id        String @id
  count     Int    @default(0)
  expiresAt Int
  @@index([expiresAt])
}
