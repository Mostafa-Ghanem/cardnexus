{
  "name": "cardnexus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "prisma generate && vite build",
    "preview": "vite preview",
    "deploy": "prisma generate && npx @vinext/cloudflare deploy",
    "check": "prisma validate && tsc --noEmit && eslint app components lib --ext .ts,.tsx",
    "db:generate": "prisma generate",
    "db:migration:generate": "node scripts/export-d1-migration.mjs",
    "db:migration:local": "wrangler d1 migrations apply cardnexus-d1 --local",
    "db:migration:remote": "wrangler d1 migrations apply cardnexus-d1 --remote",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "lint": "eslint app components lib --ext .ts,.tsx"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "better-auth": "^1.6.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.488.0",
    "nanoid": "^5.1.16",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.3",
    "sonner": "^2.0.7",
    "stripe": "^22.1.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.2",
    "@prisma/adapter-d1": "^6.19.0",
    "vinext": "latest",
    "@vinext/cloudflare": "latest",
    "@cloudflare/vite-plugin": "latest",
    "@vitejs/plugin-rsc": "latest",
    "react-server-dom-webpack": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "postcss": "^8",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "latest",
    "@cloudflare/workers-types": "latest"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "type": "module"
}
